<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms is used only for the tray icon (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>InfiniteSpace</RootNamespace>
    <AssemblyName>InfiniteSpace</AssemblyName>
    <StartupObject>InfiniteSpace.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- DPI awareness belongs in the manifest for a WPF app; WinForms is only here for the tray icon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <!-- SpaceWindow writes frames straight into a DIB section. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      Published builds are compiled ahead of time (ReadyToRun), so the first drag, paint or reshape
      after start doesn't wait for the JIT; tiered PGO then tunes the hot paths as usual.
    -->
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep WPF types unambiguous: WinForms/GDI types are referenced through aliases. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="0.41.3" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="InfiniteSpace.Tests" />
    <InternalsVisibleTo Include="InfiniteSpace.Perf" />
  </ItemGroup>

</Project>
