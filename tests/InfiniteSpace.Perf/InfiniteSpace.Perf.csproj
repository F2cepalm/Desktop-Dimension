<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Scripted actions on real spaces (real GPU, windows kept off screen), timed frame by frame:
    "dotnet run -c Release (project tests/InfiniteSpace.Perf)"
    See Program.cs for the options.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- The same DPI awareness as the app, so frames are the size they are there. -->
    <ApplicationManifest>..\..\src\InfiniteSpace\app.manifest</ApplicationManifest>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\InfiniteSpace\InfiniteSpace.csproj" />
  </ItemGroup>

</Project>
